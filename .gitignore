.env
.env.*
!.env.example
infra/compose/.env
infra/compose/.account-access-codes.runtime.json

.secrets/
secrets/*.enc.json
secrets/*.json
!secrets/README.md
*.key
*.plaintext
*.decrypted

node_modules/
dist/
build/
target/
.next/
coverage/
output/
.playwright-cli/

# Keep durable release checkpoint evidence even when a workstation-wide
# ignore rule excludes directories whose names start with "release".
!docs/
!docs/release-checkpoints/
!docs/release-checkpoints/**

# The workstation's global Visual Studio ignore pattern matches packages/*.
# Keep this workspace package versioned; Docker builds copy it directly.
!packages/
!packages/hermes-compat/
!packages/hermes-compat/package.json
!packages/hermes-compat/tsconfig.json
!packages/hermes-compat/src/
!packages/hermes-compat/src/**
!packages/eventing/
!packages/eventing/package.json
!packages/eventing/tsconfig.json
!packages/eventing/src/
!packages/eventing/src/**

.DS_Store
mobile alias
