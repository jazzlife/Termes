POSTGRES_DB=termes
POSTGRES_USER=termes
POSTGRES_PASSWORD=change-this-postgres-password

MINIO_ROOT_USER=termes
MINIO_ROOT_PASSWORD=change-this-minio-password

TERMES_WEB_PORT=4180
TERMES_WEB_BIND=127.0.0.1
TERMES_API_PORT=4181
TERMES_API_BIND=127.0.0.1
TERMES_NPM_NETWORK=npm_bridge
PUBLIC_BASE_URL=https://termes.example.com
GITHUB_OAUTH_CALLBACK_URL=https://termes.example.com/api/github/oauth/callback
TERMES_SINGLE_ACCOUNT_ID=00000000-0000-0000-0000-000000000001
TERMES_SINGLE_WORKSPACE_ID=10000000-0000-0000-0000-000000000001
TERMES_SINGLE_RUNTIME_CELL_ID=20000000-0000-0000-0000-000000000001
TERMES_OAUTH_ADMIN_ACCOUNT_ID=00000000-0000-0000-0000-000000000001
TERMES_ACCOUNT_ACCESS_HASHES_JSON={"00000000-0000-0000-0000-000000000001":"79efe14cebe3e64323b3d4ff0c584b8ec3dfd0d10a8b9b8296e4711b9bfcc289","00000000-0000-0000-0000-000000000002":"52e05e7616ec2e321314d3d2bc13671dc6459e660c7e728d113a261ff45ad5ef"}
TERMES_WORKSPACES_HOST_ROOT=/data/docker_data/termes/workspaces/users
TERMES_ACCOUNT_WORKSPACE_HOST_ROOT=/data/docker_data/termes/workspaces/users/00000000-0000-0000-0000-000000000001
TERMES_PRIMARY_PROJECT_HOST_ROOT=/data/docker_data/termes/app
TERMES_ACCOUNT_RUNS_HOST_ROOT=/data/docker_data/termes/runs/users/00000000-0000-0000-0000-000000000001
TERMES_ACCOUNT_HERMES_HOST_ROOT=/data/docker_data/termes/account-cells/00000000-0000-0000-0000-000000000001/hermes
TERMES_SECOND_ACCOUNT_ID=00000000-0000-0000-0000-000000000002
TERMES_SECOND_WORKSPACE_ID=10000000-0000-0000-0000-000000000002
TERMES_SECOND_RUNTIME_CELL_ID=20000000-0000-0000-0000-000000000002
TERMES_SECOND_ACCOUNT_WORKSPACE_HOST_ROOT=/data/docker_data/termes/workspaces/users/00000000-0000-0000-0000-000000000002
TERMES_SECOND_ACCOUNT_RUNS_HOST_ROOT=/data/docker_data/termes/runs/users/00000000-0000-0000-0000-000000000002
TERMES_SECOND_ACCOUNT_HERMES_HOST_ROOT=/data/docker_data/termes/account-cells/00000000-0000-0000-0000-000000000002/hermes

DEVICE_COMMAND_TIMEOUT_MS=30000
DEVICE_ALLOWED_HOSTS=
WINRM_ALLOWED_HOSTS=

# GitHub project registration. Prefer OAuth for browser login; GITHUB_TOKEN can
# be used for server-side bootstrap/testing without exposing the token to web UI.
GITHUB_CLIENT_ID=
GITHUB_BROWSER_OAUTH_ENABLED=true

GITHUB_OAUTH_SCOPE=repo read:org
GITHUB_CLIENT_SECRET_ENC=
GITHUB_SECRET_KEY_FILE=/data/docker_data/termes/secrets/github-oauth.key
GITHUB_TOKEN=
GITHUB_LOGIN=

# Managed Termes mode keeps HERMES_API_BASE_URL blank and uses runner-supervisor.
# To use the official Hermes Agent container, set:
# HERMES_AGENT_API_KEY=<strong-random-key>
# HERMES_API_BASE_URL=http://hermes-agent:8642
# HERMES_API_KEY=<same-as-HERMES_AGENT_API_KEY>
# Then start with: docker compose --profile hermes-upstream ...
HERMES_API_BASE_URL=
HERMES_API_KEY=
HERMES_AGENT_API_KEY=replace-with-strong-hermes-agent-api-key
HERMES_AGENT_GATEWAY_ALLOW_ALL_USERS=true
HERMES_MANAGER_SERVICE_TOKEN=replace-with-strong-manager-service-token
HERMES_CELL_AUTHORITY_TOKEN=replace-with-strong-cell-authority-token
HERMES_DASHBOARD_SESSION_TOKEN=replace-with-strong-dashboard-session-token
HERMES_UID=10000
HERMES_GID=10000
HERMES_RUN_TIMEOUT_MS=900000
HERMES_CELL_CPUS=4
HERMES_CELL_MEMORY=8g
HERMES_CELL_PIDS=512

# OpenAI execution uses ChatGPT/Codex OAuth only. Provider API keys are not used.
