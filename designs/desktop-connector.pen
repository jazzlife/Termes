    {
      "type": "note",
      "id": "cxa9C",
      "x": 2992,
      "y": 0,
      "name": "ActivityMonitorStateContract",
      "context": "State contract annotation.",
      "width": 360,
      "height": 150,
      "content": "STATE CONTRACT\nActivity button: default / hover / focus / pressed / disabled while loading.\nDialog: open / populated / empty. Empty copy: ‘아직 기록된 작업이 없습니다.’\nActivity rows: neutral / success / failure. Status is always text-supported, never color-only."
    },
    {
      "type": "note",
      "id": "U4pES",
      "x": 2992,
      "y": 170,
      "name": "ActivityMonitorAccessibilityContract",
      "context": "Accessibility contract annotation.",
      "width": 360,
      "height": 170,
      "content": "ACCESSIBILITY CONTRACT\nFocus order: Close → timeline. On open, focus Close; on close, restore Activity button.\nEscape and backdrop click close the dialog.\nDialog role with label ‘활동 기록’.\nAll action targets are at least 44×44. Body text contrast meets WCAG AA in dark mode."
    },
    {
      "type": "note",
      "id": "PlBfX",
      "x": 2992,
      "y": 360,
      "name": "ActivityMonitorMotionContract",
      "context": "Motion contract annotation.",
      "width": 360,
      "height": 110,
      "content": "MOTION CONTRACT\nBackdrop 120ms ease-out; dialog opacity + translateY(6→0) 140ms ease-out.\nRespect prefers-reduced-motion by removing translation and using opacity only."
    },
    {
      "type": "note",
      "id": "TAi3g",
      "x": 2992,
      "y": 490,
      "name": "ActivityMonitorAnalyticsContract",
      "context": "Analytics contract annotation.",
      "width": 360,
      "height": 105,
      "content": "ANALYTICS EVENTS\nconnector.activity_open\nconnector.activity_close { method: close | escape | backdrop }\nconnector.forget_confirm_open remains in the connection pane."
    },
    {
      "type": "note",
      "id": "Mk29T",
      "x": 3382,
      "y": 0,
      "name": "ActivityMonitorI18nContract",
      "context": "Internationalization contract annotation.",
      "width": 360,
      "height": 130,
      "content": "I18N NOTES\nActivity title/detail wrap or ellipsize independently; timestamps never wrap.\nAllow 30% label expansion. Dialog width stays bounded; timeline becomes scrollable when content exceeds available height."
    },
    {
      "type": "note",
      "id": "hmSC1",
      "x": 3382,
      "y": 150,
      "name": "ActivityMonitorFlowContext",
      "context": "Flow context annotation.",
      "width": 360,
      "height": 135,
      "content": "FLOW CONTEXT\nConnected main window → Activity button → monitoring dialog → close → connected main window.\nNo route change and no activity deletion.\nForget Connection deletes credentials/settings, not activity entries, and remains in Connection Pane."
    }
  ],
