{
  "name": "@termes/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "esbuild src/server.ts src/migrate.ts --bundle --platform=node --target=node22 --format=cjs --out-extension:.js=.cjs --outdir=dist --external:pg-native",
    "start": "node dist/server.cjs",
    "migrate": "node dist/migrate.cjs"
  },
  "dependencies": {
    "@termes/eventing": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.3.0",
    "@termes/shared": "workspace:*",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "nanoid": "^5.1.5",
    "pg": "^8.16.2",
    "ws": "^8.21.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  }
}
